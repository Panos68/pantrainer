# ── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string. A free MongoDB Atlas (M0) cluster is plenty.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Owner password for the web app.
AUTH_PASSWORD=change-me

# Long random secret used to sign login sessions, OAuth codes and photo links.
# Generate one with:  openssl rand -base64 32
AUTH_SESSION_SECRET=

# ── Photos ──────────────────────────────────────────────────────────────────
# Vercel Blob read/write token (Vercel dashboard → Storage → Blob). Needed for
# session photos and food photos; everything else works without it.
BLOB_READ_WRITE_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# IANA timezone that defines "today" for logging and daily rollovers.
APP_TIMEZONE=UTC

# Second password that can only open /food (e.g. for a partner who logs meals).
FOOD_ACCESS_PASSWORD=

# Secret Vercel Cron sends as a Bearer token to /api/cron/* (set automatically
# on Vercel when you add it as an env var).
CRON_SECRET=

# Public URL of this instance, used in links handed to Claude.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Preferred OpenFoodFacts product-name language for barcode scans (ISO 639-1).
FOOD_PRODUCT_LANGUAGE=en

# Seed the pantry with example staples on first use (true/false).
SEED_EXAMPLE_PANTRY=false

# Legacy single shared automation token. Prefer creating tokens in
# Settings → API tokens; this stays supported for existing setups.
AUTOMATION_API_TOKEN=

# ── Integrations (each one is enabled just by setting its credentials) ───────
# Garmin Connect via the unofficial garmin-connect package. The account must
# not have MFA enabled.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Renpho smart scale (weight / body composition).
RENPHO_EMAIL=
RENPHO_PASSWORD=

# ── Self-hosting (Docker) ───────────────────────────────────────────────────
# Where photos are stored when BLOB_READ_WRITE_TOKEN isn't set. The Docker image
# sets this to /data/uploads (a volume) for you.
# STORAGE_DIR=/data/uploads

# Only for testing over plain http on a private network. Leave unset otherwise.
# ALLOW_INSECURE_COOKIES=true

# Set to true only behind a reverse proxy (Caddy, Traefik, nginx…) that
# overwrites X-Forwarded-For. Then login rate limiting is per client IP;
# otherwise all clients share one limit so the header can't be spoofed.
# (Not needed on Vercel.)
# TRUST_PROXY=true
